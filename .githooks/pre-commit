#!/usr/bin/env bash
# Pre-commit hook — fast checks only (<5 seconds)
# Install: git config core.hooksPath .githooks

echo "==> Pre-commit: validating doc references..."
bash cli/validate.sh || exit 1

echo ""
echo "==> Pre-commit: checking shell script permissions..."
FAILED=0
while IFS= read -r -d '' script; do
  if [ ! -x "$script" ]; then
    echo "  ERROR: $script is not executable (run: chmod +x $script)"
    FAILED=1
  fi
done < <(find base/scripts base/.claude/hooks base/.opencode/hooks cli -name "*.sh" -print0 2>/dev/null)

if [ "$FAILED" -eq 1 ]; then
  exit 1
fi
echo "  All scripts executable."

echo ""
echo "==> Pre-commit: checking for common issues..."
if git diff --cached --name-only | grep -qE '^\.env$'; then
  echo "  ERROR: .env file staged — secrets should not be committed"
  exit 1
fi

echo ""
echo "Pre-commit checks passed."
