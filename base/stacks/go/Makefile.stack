# Makefile.stack — Go
# Auto-generated by compose.sh. Edit to match your project.
SRC_EXTENSIONS ?= go
SRC_DIR ?= .

dev: ## Start development server
	go run ./cmd/server

build: ## Build binary
	go build -o bin/server ./cmd/server

format: ## Format with gofmt
	gofmt -w .

lint: ## Lint with golangci-lint
	golangci-lint run ./...

types: ## Go is statically typed — this is a no-op
	@echo "Go is statically typed — no separate type check needed"

deadcode: ## Detect dead code
	@command -v deadcode >/dev/null 2>&1 && deadcode ./... || echo "Install: go install golang.org/x/tools/cmd/deadcode@latest"

test: ## Run all tests
	go test ./...

test-feature: ## Run tests with verbose output
	go test -v ./...

clean: ## Remove build artifacts
	rm -rf bin/
