# Makefile.stack — Python
# Auto-generated by compose.sh. Edit to match your project.
SRC_EXTENSIONS ?= py
SRC_DIR ?= src

dev: ## Start development server
	uvicorn main:app --reload

build: ## Install package
	pip install -e .

format: ## Format with ruff
	ruff format .

lint: ## Lint with ruff
	ruff check .

types: ## Type check with mypy
	mypy .

deadcode: ## Detect dead code with vulture
	@command -v vulture >/dev/null 2>&1 && vulture . || echo "Install: pip install vulture"

test: ## Run all tests
	pytest

test-feature: ## Run tests with verbose output
	pytest -v

clean: ## Remove build artifacts
	rm -rf dist/ build/ *.egg-info __pycache__ .pytest_cache .mypy_cache
