# Makefile.stack — .NET (C#)
# Auto-generated by compose.sh. Edit to match your project.
SRC_EXTENSIONS ?= cs
SRC_DIR ?= .

dev: ## Run in development mode
	dotnet run

build: ## Build project
	dotnet build -c Release

format: ## Format code
	dotnet format

lint: ## Check formatting without changes
	dotnet format --verify-no-changes

types: ## C# is statically typed — build covers this
	dotnet build --no-restore

deadcode: ## Dead code detection (use IDE analysis)
	@echo "Use IDE analysis tools for dead code detection in .NET"

test: ## Run all tests
	dotnet test

test-feature: ## Run tests with verbose output
	dotnet test -v normal

clean: ## Remove build artifacts
	dotnet clean
	rm -rf bin/ obj/
