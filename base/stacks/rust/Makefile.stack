# Makefile.stack — Rust
# Auto-generated by compose.sh. Edit to match your project.
SRC_EXTENSIONS ?= rs
SRC_DIR ?= src

dev: ## Run in development mode
	cargo run

build: ## Build release binary
	cargo build --release

format: ## Format with rustfmt
	cargo fmt

lint: ## Lint with clippy
	cargo clippy -- -D warnings

types: ## Rust is statically typed — this is a no-op
	@echo "Rust is statically typed — no separate type check needed"

deadcode: ## Detect dead code (cargo warns about unused code by default)
	cargo build 2>&1 | grep "warning: unused"

test: ## Run all tests
	cargo test

test-feature: ## Run tests with output
	cargo test -- --nocapture

clean: ## Remove build artifacts
	cargo clean
