---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
---

<Base title="My Site">
  <Header />

  <main>
    <section style="text-align:center;padding:6rem 2rem 4rem;max-width:640px;margin:0 auto;">
      <h1 style="font-size:2.5rem;margin-bottom:1rem;">Welcome to My Site</h1>
      <p style="font-size:1.125rem;opacity:0.8;">
        A minimal starter built with Astro and TypeScript.
      </p>
    </section>

    <section id="features" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;max-width:960px;margin:0 auto;padding:2rem;">
      <div style="background:#1e293b;padding:1.5rem;border-radius:8px;">
        <h3 style="color:#38bdf8;margin-bottom:0.5rem;">Fast</h3>
        <p>Zero JavaScript by default — ship only what you need.</p>
      </div>
      <div style="background:#1e293b;padding:1.5rem;border-radius:8px;">
        <h3 style="color:#38bdf8;margin-bottom:0.5rem;">Flexible</h3>
        <p>Use any UI framework or none at all.</p>
      </div>
      <div style="background:#1e293b;padding:1.5rem;border-radius:8px;">
        <h3 style="color:#38bdf8;margin-bottom:0.5rem;">Content-first</h3>
        <p>Built for content-rich sites with great SEO defaults.</p>
      </div>
    </section>
  </main>
</Base>
