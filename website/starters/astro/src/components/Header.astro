---
interface Props {
  siteName?: string;
}

const { siteName = "My Site" } = Astro.props;

const navLinks = [
  { href: "#features", label: "Features" },
  { href: "#about", label: "About" },
];
---

<header style="padding:1rem 2rem;border-bottom:1px solid #1e293b;">
  <nav style="display:flex;justify-content:space-between;align-items:center;max-width:960px;margin:0 auto;">
    <a href="/" style="font-weight:700;font-size:1.25rem;color:#38bdf8;text-decoration:none;">
      {siteName}
    </a>
    <ul style="display:flex;gap:1.5rem;list-style:none;">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} style="color:#e2e8f0;text-decoration:none;">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
